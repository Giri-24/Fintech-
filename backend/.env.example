# Frontend URL for PayPal return & cancel redirects (and CORS)
FRONTEND_URL=http://localhost:3000

# Required for real Sandbox/Live orders
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Required for webhook signature verification
# Create the webhook in the PayPal Developer Dashboard and copy the ID
PAYPAL_WEBHOOK_ID=

# Google Gemini AI API Key for real-time procurement copilot & negotiation analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
